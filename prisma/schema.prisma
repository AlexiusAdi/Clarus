generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                @id @default(cuid())
  name                  String?
  email                 String                @unique
  emailVerified         DateTime?
  image                 String?
  plan                  PlanType              @default(FREE)
  planExpiresAt         DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  account               Account[]
  assets                Asset[]
  categories            Category[]
  investments           Investment[]
  sessions              Session[]
  transactions          Transaction[]
  goals                 Goal[]
  userDetail            UserDetail?
  scheduledTransactions ScheduledTransaction[]
  planHistory           PlanHistory[]
}

model PlanHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromPlan  PlanType
  toPlan    PlanType
  source    String
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model ScheduledTransaction {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal         @db.Decimal(18, 2)
  type        TransactionType
  description String?
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id])
  goalId      String?
  goal        Goal?           @relation(fields: [goalId], references: [id])
  frequency   Frequency
  interval    Int             @default(1)
  startDate   DateTime
  endDate     DateTime?
  nextRunDate DateTime
  lastRunDate DateTime?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([nextRunDate, isActive])
}

model UserDetail {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageSize          Int      @default(10)
  financialResetDay Int      @default(1)
  emailNotification Boolean  @default(false)
  notificationDay   Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Category {
  id                    String                @id @default(uuid())
  name                  String
  type                  TransactionType
  isDefault             Boolean               @default(false)
  createdAt             DateTime              @default(now())
  userId                String?
  user                  User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  scheduledTransactions ScheduledTransaction[]

  @@index([userId])
  @@unique([name, type, userId])
}

model Transaction {
  id           String          @id @default(uuid())
  amount       Decimal         @db.Decimal(18, 2)
  type         TransactionType
  description  String?
  date         DateTime
  createdAt    DateTime        @default(now())
  categoryId   String?
  goalId       String?
  userId       String
  category     Category?       @relation(fields: [categoryId], references: [id])
  goal         Goal?           @relation(fields: [goalId], references: [id])
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentId String?
  investment   Investment?     @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  assetId      String?
  assets       Asset?          @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([categoryId])
  @@index([goalId])
  @@index([investmentId])
  @@index([assetId])
}

model Asset {
  id                String            @id @default(uuid())
  name              String
  type              AssetType
  value             Decimal           @db.Decimal(18, 2)
  acquisitionSource AcquisitionSource @default(OTHER)
  date              DateTime
  createdAt         DateTime          @default(now())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@index([userId])
}

model Investment {
  id              String         @id @default(uuid())
  name            String
  type            InvestmentType
  assetIdentifier String
  quantity        Decimal        @db.Decimal(18, 2)
  unit            String
  costPerUnit     Decimal        @db.Decimal(18, 2)
  totalInvestment Decimal        @db.Decimal(18, 2)
  date            DateTime
  trackOnly       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetPrice      AssetPrice?    @relation(fields: [assetIdentifier], references: [identifier])
  transactions    Transaction[]

  @@index([userId])
  @@index([assetIdentifier])
}

model AssetPrice {
  identifier  String         @id
  type        InvestmentType
  priceIdr    Decimal        @db.Decimal(18, 2)
  updatedAt   DateTime       @updatedAt
  investments Investment[]

  @@index([type])
}

model Goal {
  id                    String                @id @default(uuid())
  name                  String
  targetAmount          Decimal               @db.Decimal(18, 2)
  currentAmount         Decimal               @db.Decimal(18, 2) @default(0)
  deadline              DateTime?
  isCompleted           Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  userId                String
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  scheduledTransactions ScheduledTransaction[]

  @@index([userId])
}

enum PlanType {
  FREE
  PRO
  ELITE
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum TransactionType {
  EXPENSE
  INCOME
  INVESTMENTS
  ASSETS
  SAVINGS
}

enum AssetType {
  CASH
  BANK
  PROPERTY
  VEHICLE
  OTHER
  GOLD
}

enum InvestmentType {
  STOCK
  CRYPTO
  GOLD
  OTHER
}

enum AcquisitionSource {
  PURCHASED
  GIFTED
  INHERITED
  OTHER
}